{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Inventory",
  "version": "1.0.0",
  "identifier": "com.posinventory.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "POS Inventory",
        "width": 1366,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/app",
      "resources/php"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Offline POS & Inventory",
    "longDescription": "Professional Offline POS and Inventory Management System for Windows.",
    "category": "Business"
  }
}
